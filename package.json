{
  "name": "spesabot",
  "version": "0.1.0",
  "description": "Local retail intelligence platform — personalized savings engine for Italian families",
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/webapp dist/",
    "dev": "tsc --watch",
    "deploy-webapp": "cp -r src/webapp dist/ && echo 'webapp deployed to dist/'",
    "pipeline": "node dist/runner.js",
    "ingest": "node dist/ingest.js",
    "api": "node dist/api/server.js",
    "bot": "node dist/bot/bot.js",
    "fill": "node dist/manual-image-fill.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.0",
    "fastify": "^5.3.0",
    "grammy": "^1.35.0",
    "pg": "^8.16.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.0",
    "typescript": "^5.8.0"
  }
}
